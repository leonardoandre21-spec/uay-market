# Copie para .env. Nunca versione o .env.

# Banco Postgres.
# Desenvolvimento: Postgres embutido (npm run db:local) em localhost:5433.
# Produção (Neon): DATABASE_URL = conexão pooled (host com "-pooler"), DATABASE_URL_UNPOOLED = conexão direta (migrações); a integração Neon ↔ Vercel cria as duas sozinha.
DATABASE_URL="postgresql://uay:uay@localhost:5433/uay_market"
DATABASE_URL_UNPOOLED="postgresql://uay:uay@localhost:5433/uay_market"

# 32+ caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em produção o login não funciona com este valor de exemplo, com um "dev-..." nem com menos de 32 caracteres.
SESSAO_SEGREDO="troque-por-um-segredo-longo-e-aleatorio"

# Só se o sistema for acessado em http:// fora de localhost (no Vercel é https, não precisa):
# COOKIE_INSEGURO=1

# PIN do administrador criado pelo seed (só na primeira vez)
ADMIN_PIN_INICIAL=1234
